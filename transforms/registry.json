    {
      "id": "registry.builtin-provider-predicate",
      "description": "Treat OpenAI providers as built-in workspace providers",
      "instances": [
        {
          "target": "glm",
          "span": 10,
          "edits": [
            {
              "operation": "insert-after-match",
              "locate": "([A-Za-z_$][\\w$]*)===([A-Za-z_$][\\w$]*)\\.zapi(?=\\})",
              "insert": "||$1===$2.openai||$1===$2.openaiCodingPlan||$1===$2.openaiStartPlan"
            }
          ]
        },
        {
          "target": "host.protocol",
          "span": 1,
          "edits": [

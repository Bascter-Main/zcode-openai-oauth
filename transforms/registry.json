    {
      "id": "glm.reasoning-levels-parser",
      "description": "Read reasoning levels from protocol arrays and internal objects",
      "instances": [
        {
          "target": "glm",
          "span": 11,
          "edits": [
            {
              "operation": "replace-match",
              "locate": "function ([A-Za-z_$][\\w$]*)\\(([A-Za-z_$][\\w$]*)\\)\\{return \\2\\.reasoning\\?\\.levels\\.map\\(([A-Za-z_$][\\w$]*)=>\\3\\.value\\)\\?\\?\\[\\]\\}",
              "template": "function $1($2){let t=$2.reasoning?.levels;if(!t)return[];if(Array.isArray(t))return t.map(t=>t.value);if(typeof t===\"object\")return Object.keys(t);return[]}"
            }
          ]
        }
      ]
    }
  ]
